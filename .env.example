# =========================================================================
# LuxeStay - Client Environment Variables Template
# Envato Marketplace Standard
# =========================================================================

# Backend API URL (Default: /api for Vite & Netlify reverse proxy)
# To connect to an external server directly: VITE_API_URL=https://your-api-domain.com/api
VITE_API_URL=/api

# Optional: Firebase Google Authentication Keys (If using custom Firebase app)
# VITE_FIREBASE_API_KEY=your_api_key_here
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
